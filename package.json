{
  "name": "curve-digitizer",
  "version": "0.0.0",
  "private": true,
  "description": "PDF-first, fully in-browser graph digitizer for engineers.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @cd/web dev",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:samples": "vitest run --config vitest.samples.config.ts",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @cd/web build && pnpm size",
    "size": "node scripts/size-check.ts apps/web/dist",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cd/math": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
